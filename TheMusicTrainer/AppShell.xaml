<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TheMusicTrainer.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:TheMusicTrainer.Views"
    Title="TheMusicTrainer">

    <TabBar>
        <ShellContent
            Title="Exercises 🎵"
            ContentTemplate="{DataTemplate views:ExerciseSelectionPage}"
            Route="Exercises" />

        <ShellContent
            Title="Progress 📊"
            ContentTemplate="{DataTemplate views:ProgressPage}"
            Route="Progress" />

        <ShellContent
            Title="Profile 👤"
            ContentTemplate="{DataTemplate views:ProfilePage}"
            Route="Profile" />

        <ShellContent
            Title="Challenge Mode ☠️"
            ContentTemplate="{DataTemplate views:ChallengePage}"
            Route="Challenge" />
    </TabBar>

</Shell>
